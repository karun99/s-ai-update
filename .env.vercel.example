# S-AI — Vercel deployment environment (configurable)
#
# Copy the variables you need into the Vercel project's Environment Variables
# (Vercel dashboard -> Project -> Settings -> Environment Variables), or in CI:
#   vercel env add VARIABLE_NAME
#
# ── Authentication (configurable) ──────────────────────────────────────────
# Either set a deterministic API key, or disable auth for a public dashboard.
# Default (unset) keeps bearer auth enabled with a per-instance token.
SAI_API_KEY=                     # required bearer token for protected routes
SAI_AUTH_MODE=off                # "off" = public/demo; leave unset to require auth

# ── Persistent state location ──────────────────────────────────────────────
# Serverless state is ephemeral. Point here at a durable volume/object store in
# production, or leave unset for /tmp-like per-invocation storage.
# SAI_DATA_DIR=/var/data/s-ai

# ── AI provider API keys (set at least ONE for working AI features) ────────
OPENROUTER_API_KEY=              # recommended (100+ models, free tier available)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
NVIDIA_API_KEY=
COHERE_API_KEY=
GROK_API_KEY=
KIMI_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
PI_API_KEY=

# ── Bhashini multilingual AI ───────────────────────────────────────────────
BHASHINI_API_KEY=
BHASHINI_USER_ID=s-ai-user
BHASHINI_PIPELINE_ID=

# ── Active primary provider (default: openrouter) ──────────────────────────
SAI_PRIMARY_PROVIDER=openrouter
