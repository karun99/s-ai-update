<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="S-AI Multi-Agent Swarm Intelligence"
           Language="1033"
           Version="5.1.0"
           Manufacturer="nsk"
           UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="S-AI v5.1 - Multi-Agent Swarm Intelligence with Neural Mapping, MCP, and 20+ AI Providers"
             Comments="MIT License - Copyright (c) 2026 nsk" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of S-AI is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="ProductFeature" Title="S-AI" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="PathComponent" />
    </Feature>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="S-AI" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="S-AI" />
      </Directory>
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="AppComponent" Guid="11111111-2222-3333-4444-555555555555">
        <File Id="s-ai.exe"
              Source="build/dist/windows/s-ai.exe"
              KeyPath="yes"
              Name="s-ai.exe" />
      </Component>
      <Component Id="PathComponent" Guid="22222222-3333-4444-5555-666666666666">
        <Environment Id="PATH"
                     Name="PATH"
                     Value="[INSTALLFOLDER]"
                     Permanent="no"
                     Part="last"
                     Action="set"
                     System="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ShortcutComponent" Guid="33333333-4444-5555-6666-777777777777">
        <Shortcut Id="StartMenuShortcut"
                  Name="S-AI"
                  Description="S-AI Multi-Agent Swarm Intelligence"
                  Target="[INSTALLFOLDER]s-ai.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="sai.ico" />
        <Shortcut Id="UninstallShortcut"
                  Name="Uninstall S-AI"
                  Target="[System64Folder]msiexec.exe"
                  Arguments="/x [ProductCode]" />
        <RemoveFolder Id="CleanUpShortcutFolder"
                      Directory="ApplicationProgramsFolder"
                      On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\S-AI"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Fragment>
      <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
        <Component Id="ConfigDefault" Guid="44444444-5555-6666-7777-888888888888">
          <File Id="config.default.json"
                Source="config.default.json"
                KeyPath="yes" />
        </Component>
        <Component Id="ReadmeComponent" Guid="55555555-6666-7777-8888-999999999999">
          <File Id="README.md"
                Source="README.md"
                KeyPath="yes" />
        </Component>
        <Component Id="LicenseComponent" Guid="66666666-7777-8888-9999-AAAAAAAAAAAA">
          <File Id="LICENSE"
                Source="LICENSE"
                KeyPath="yes" />
        </Component>
      </ComponentGroup>
    </Fragment>
  </Product>
</Wix>
